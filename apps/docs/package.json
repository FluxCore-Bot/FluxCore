{
  "name": "@fluxcore/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001 --hostname 0.0.0.0",
    "docs:dev": "next dev --port 3001 --hostname 0.0.0.0",
    "docs:build": "node scripts/check-css-imports.mjs && next build",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "manifest": "node scripts/manifest/build.mjs",
    "check-coverage": "node scripts/check-coverage.mjs",
    "clean": "rm -rf .next out .source"
  },
  "dependencies": {
    "fumadocs-core": "^16.13.0",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.13.0",
    "next": "^16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  }
}
